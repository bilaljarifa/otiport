{
  // Alternative sans débogueur : Terminal → Exécuter la tâche…
  // "Optiport : démarrer tout" ouvre l'API FastAPI et le serveur de dev
  // Vite (React) en parallèle, chacun dans son propre panneau de terminal.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "API (Uvicorn)",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe",
      "args": ["-m", "uvicorn", "api:app", "--port", "8000", "--reload"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "group": "optiport", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Frontend (Vite dev server)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "group": "optiport", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Optiport : démarrer tout",
      "dependsOn": ["API (Uvicorn)", "Frontend (Vite dev server)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
