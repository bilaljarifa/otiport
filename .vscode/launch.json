{
  // Ouvrez le dossier "Optiport" dans VS Code, puis F5 pour déboguer le
  // backend FastAPI. Le frontend React (Vite) se lance séparément dans un
  // terminal — voir la tâche "Frontend (Vite dev server)" ou `npm run dev`
  // dans frontend/ (pas de débogueur Python applicable côté React).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (FastAPI / Uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api:app", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "API avec rechargement auto (sans points d'arrêt)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api:app", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
