# Environnement virtuel — ne jamais versionner (recréé via requirements.txt)
venv/
.venv/
env/

# Artefacts Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Modèles entraînés (volumineux, générés par train_model.py)
trained_models_LSTM_2000_epochs/
*.keras
*.h5
*.pkl

# Journaux et fichiers temporaires
*.log
.DS_Store
Thumbs.db

# Base de données de développement (SQLite) — le préfixe couvre aussi les
# sauvegardes ponctuelles (ex. optiport.db.backup_YYYYMMDD_HHMMSS)
optiport.db*
*.db-journal

# Secrets — .env holds real values locally (NEWS_API_KEY, GROQ_API_KEY,
# GOOGLE_CLIENT_SECRET, AUTH_SECRET_KEY...); never tracked, never committed.
*.env
.env
*.pem
*.key

# Local dev tooling — machine-specific, not part of the application
.claude/
.run/
