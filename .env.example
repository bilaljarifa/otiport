# Copy to .env and fill in. .env is already gitignored — never commit real secrets.

# --- News / sentiment (optional) ---
NEWS_API_KEY=

# --- Auth (backend/config.py) ---
# Long random string used to sign JWT access tokens. If unset, the backend
# generates a random one at startup — fine for a quick local run, but every
# issued token becomes invalid on the next restart. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=
# Access token lifetime, in minutes. Defaults to 480 (8h) if unset.
AUTH_TOKEN_EXPIRE_MINUTES=480

# --- Database ---
# Defaults to a SQLite file at the repo root (sqlite:///<repo>/optiport.db).
DATABASE_URL=

# --- First admin bootstrap (python -m backend.create_admin) ---
# All optional — anything left unset is prompted for interactively instead,
# with the password read via getpass (never echoed to the terminal).
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# --- Google OAuth ("Continue with Google" on login/register, optional) ---
# All three required together, or the button stays hidden/disabled.
# Setup: console.cloud.google.com -> APIs & Services -> Credentials ->
# Create OAuth client ID (type: Web application) -> add the exact URL below
# as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501

# --- CORS (only needed for the React frontend — a browser origin) ---
# Comma-separated. Defaults to the Vite dev server + Streamlit's own port if unset.
CORS_ALLOWED_ORIGINS=

# --- AI Assistant ---
# Which LLM backend answers /assistant/chat: "groq" (default — hosted,
# free tier, no local compute needed) or "openai" (paid, needs
# OPENAI_API_KEY below).
AI_PROVIDER=groq

# Used only when AI_PROVIDER=groq. Free key: https://console.groq.com/keys
# GROQ_MODEL must support tool/function calling — llama-3.3-70b-versatile
# is Groq's current recommended general-purpose tool-calling model.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Used only when AI_PROVIDER=openai. Hidden/disabled until set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
