# Copy to .env and fill in. .env is already gitignored — never commit real secrets.

# --- News / sentiment (optional) ---
NEWS_API_KEY=

# --- Auth (backend/config.py) ---
# Long random string used to sign JWT access tokens. If unset, the backend
# generates a random one at startup — fine for a quick local run, but every
# issued token becomes invalid on the next restart. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=
# Access token lifetime, in minutes. Defaults to 480 (8h) if unset.
AUTH_TOKEN_EXPIRE_MINUTES=480

# --- Database ---
# Defaults to a SQLite file at the repo root (sqlite:///<repo>/optiport.db).
DATABASE_URL=

# --- LSTM model directory (optional) ---
# Defaults to the repo-relative trained_models_LSTM_2000_epochs/... path
# used everywhere in this project so far — leave unset for local dev. Only
# needed when the code checkout itself doesn't persist across restarts
# (e.g. Render rebuilds it from git on every deploy): point this at an
# absolute path on a persistent disk/volume instead, see DEPLOYMENT.md.
LSTM_MODEL_DIR=

# --- First admin bootstrap (python -m backend.create_admin) ---
# All optional — anything left unset is prompted for interactively instead,
# with the password read via getpass (never echoed to the terminal).
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# --- CORS (only needed for the React frontend — a browser origin) ---
# Comma-separated. Defaults to the Vite dev server (http://localhost:5173) if unset.
CORS_ALLOWED_ORIGINS=

# --- Google OAuth ("Continue with Google" on the Login page, optional) ---
# All three required together, or the button stays hidden on Login (the
# frontend asks GET /auth/google/config and only renders the button when
# every one of these is set — it never shows a button that can't work).
# GOOGLE_REDIRECT_URI must point at this BACKEND (GET /auth/google/callback
# is a real FastAPI route — the Authorized redirect URI on the Google OAuth
# client, not a frontend page); the backend does the exchange, then bounces
# the browser back to FRONTEND_URL (below) with the Optiport JWT.
# Setup: console.cloud.google.com -> APIs & Services -> Credentials ->
# Create OAuth client ID (type: Web application) -> add the exact URL below
# as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Where GET /auth/google/callback redirects back to after a Google sign-in
# (success or failure) — the React app's own origin. Defaults to the Vite
# dev server; set to the deployed frontend's URL (e.g. the Vercel domain)
# in production. Only used by the Google OAuth flow.
FRONTEND_URL=

# --- AI Assistant ---
# Which LLM backend answers /assistant/chat: "groq" (default — hosted,
# free tier, no local compute needed) or "openai" (paid, needs
# OPENAI_API_KEY below).
AI_PROVIDER=groq

# Used only when AI_PROVIDER=groq. Free key: https://console.groq.com/keys
# GROQ_MODEL must support tool/function calling and be available on your
# account/plan — model availability varies per Groq account, so verify with
# `client.models.list()` if this one 404s. openai/gpt-oss-120b is confirmed
# working (tool-calling included) as of this writing.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Used only when AI_PROVIDER=openai. Hidden/disabled until set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Payment mode ---
# "demo" or "stripe". Left unset, this is inferred automatically: "stripe"
# once the Stripe variables below are all set, "demo" otherwise — so a
# fresh checkout (e.g. no Stripe account available yet, as for this
# project's PFE demo) still gets a working, honestly-labeled Pricing page
# instead of one where every upgrade button is disabled. In demo mode,
# "Upgrade" opens an in-app simulated checkout (demo card 4242 4242 4242
# 4242 only) instead of real Stripe Checkout — no external payment
# provider is contacted and no real charge is ever possible. Set this
# explicitly to "stripe" to force real Checkout even before all the Stripe
# variables below are filled in (checkout will 503 until they are), or to
# "demo" to keep using the simulation even once Stripe is fully configured.
PAYMENT_MODE=demo

# --- Stripe billing (Pricing/Billing pages, optional) ---
# The Pricing page's "Upgrade" buttons and the Billing page's "Manage
# Billing" button stay disabled with an honest "not configured yet" message
# until STRIPE_SECRET_KEY + both price ids below are set.
#
# Setup (test mode):
#   1. dashboard.stripe.com -> Developers -> API keys -> copy the
#      "Secret key" (starts sk_test_...).
#   2. dashboard.stripe.com -> Product catalog -> add two Products
#      ("Optiport Pro", "Optiport Premium"), each with one recurring
#      monthly Price ($9.99 / $19.99) -> copy each Price's id (price_...).
#   3. Local webhook testing: install the Stripe CLI, run
#      `stripe listen --forward-to localhost:8000/billing/webhook` — it
#      prints a webhook signing secret (whsec_...) for STRIPE_WEBHOOK_SECRET
#      below. In production, add the endpoint under Developers -> Webhooks
#      instead and use the signing secret Stripe shows there, listening for
#      at least: checkout.session.completed, customer.subscription.created,
#      customer.subscription.updated, customer.subscription.deleted,
#      invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
